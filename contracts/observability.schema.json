{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nddev.ai/schemas/nddev-device-sync/v2/observability.schema.json",
  "title": "NDS observability control definitions",
  "$defs": {
    "Identifier": {
      "$ref": "https://nddev.ai/schemas/nddev-device-sync/v2/control-plane.schema.json#/$defs/Identifier"
    },
    "Timestamp": {
      "$ref": "https://nddev.ai/schemas/nddev-device-sync/v2/control-plane.schema.json#/$defs/Timestamp"
    },
    "IncidentState": {
      "title": "IncidentState",
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ]
    },
    "Incident": {
      "type": "object",
      "properties": {
        "incident_id": {
          "$ref": "#/$defs/Identifier"
        },
        "dedup_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "service_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "enum": [
            "admission",
            "database",
            "tls",
            "process",
            "source_stale",
            "source_gap",
            "delivery"
          ]
        },
        "state": {
          "$ref": "#/$defs/IncidentState"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "first_seen": {
          "$ref": "#/$defs/Timestamp"
        },
        "last_seen": {
          "$ref": "#/$defs/Timestamp"
        },
        "silenced_until": {
          "$ref": "#/$defs/Timestamp"
        },
        "resolved_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "owner": {
          "type": "string",
          "const": "operator"
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "critical"
          ]
        }
      },
      "required": [
        "incident_id",
        "dedup_key",
        "service_name",
        "kind",
        "state",
        "revision",
        "occurrences",
        "first_seen",
        "last_seen",
        "owner",
        "severity"
      ],
      "additionalProperties": false
    },
    "IncidentPage": {
      "type": "object",
      "properties": {
        "incidents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Incident"
          },
          "maxItems": 100
        },
        "next_cursor": {
          "$ref": "#/$defs/Identifier"
        },
        "generated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "incidents",
        "generated_at"
      ],
      "additionalProperties": false
    },
    "IncidentAction": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
          "description": "Canonical UUIDv7 created within ten minutes of the request. This bounds replay lifetime below receipt retention."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "operation_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "SilenceAction": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
          "description": "Canonical UUIDv7 created within ten minutes of the request. This bounds replay lifetime below receipt retention."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "until": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "operation_id",
        "expected_revision",
        "until"
      ],
      "additionalProperties": false
    },
    "SourceState": {
      "title": "SourceState",
      "type": "string",
      "enum": [
        "missing",
        "fresh",
        "stale",
        "unsequenced",
        "gap_observed",
        "inactive"
      ]
    },
    "SourceHealth": {
      "type": "object",
      "properties": {
        "service_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
        },
        "state": {
          "$ref": "#/$defs/SourceState"
        },
        "last_received_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "gap_observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "last_event_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "service_name",
        "state",
        "gap_observations"
      ],
      "additionalProperties": false
    },
    "ExportMode": {
      "title": "ExportMode",
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "IngressReceipt": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "export_mode": {
          "$ref": "#/$defs/ExportMode"
        }
      },
      "required": [
        "accepted",
        "duplicates",
        "export_mode"
      ],
      "additionalProperties": false
    },
    "SignalDelivery": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unknown",
            "healthy",
            "degraded",
            "disabled"
          ]
        },
        "successes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "last_success_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "state",
        "successes",
        "failures"
      ],
      "additionalProperties": false
    },
    "ObservabilityStatus": {
      "type": "object",
      "properties": {
        "export_mode": {
          "$ref": "#/$defs/ExportMode"
        },
        "queued_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "queued_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "delivered_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expired_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceHealth"
          },
          "maxItems": 16
        },
        "logs": {
          "$ref": "#/$defs/SignalDelivery"
        },
        "metrics": {
          "$ref": "#/$defs/SignalDelivery"
        },
        "traces": {
          "$ref": "#/$defs/SignalDelivery"
        }
      },
      "required": [
        "export_mode",
        "queued_events",
        "queued_bytes",
        "delivered_events",
        "expired_events",
        "sources",
        "logs",
        "metrics",
        "traces"
      ],
      "additionalProperties": false
    },
    "ObservabilityError": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "enum": [
            "unauthorized",
            "invalid_request",
            "capacity_exhausted",
            "dependency_unavailable",
            "not_found",
            "revision_conflict",
            "idempotency_conflict",
            "invalid_transition",
            "forbidden_scope",
            "global_grant_required"
          ]
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "ClientTelemetryPolicy": {
      "type": "object",
      "properties": {
        "export_mode": {
          "$ref": "#/$defs/ExportMode"
        }
      },
      "required": [
        "export_mode"
      ],
      "additionalProperties": false,
      "description": "Authenticated client export policy only; no global counters, sources or incidents. Company administration does not grant operator privileges."
    },
    "CollectionMode": {
      "title": "CollectionMode",
      "type": "string",
      "enum": [
        "standard",
        "debug",
        "off"
      ],
      "description": "One effective collection and export policy for a client. standard collects and exports the normal diagnostic envelope; debug additionally collects bounded debug records until debug_expires_at; off collects and exports nothing new and keeps no hidden stream."
    },
    "CollectionPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/CollectionMode"
        },
        "debug_expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mode",
        "revision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "debug"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "debug_expires_at"
            ]
          },
          "else": {
            "not": {
              "required": [
                "debug_expires_at"
              ]
            }
          }
        }
      ],
      "description": "Authenticated client collection policy. Debug is finite: it always carries its expiry and reverts to standard after it. Functional journals and action results never depend on this policy."
    },
    "DiagnosticScope": {
      "title": "DiagnosticScope",
      "type": "string",
      "enum": [
        "member",
        "organization",
        "global"
      ],
      "description": "member: the caller's own records; organization: one organization the caller administers; global: every record, only with a current global diagnostic grant."
    },
    "DiagnosticSignal": {
      "title": "DiagnosticSignal",
      "type": "string",
      "enum": [
        "logs",
        "traces",
        "metrics"
      ]
    },
    "DiagnosticFilters": {
      "title": "DiagnosticFilters",
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "event_name": {
          "$ref": "#/$defs/Identifier"
        },
        "module": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "outcome": {
          "$ref": "#/$defs/Identifier"
        },
        "trace_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "additionalProperties": false,
      "description": "Exact matches only; values are identifiers, never free text or query syntax."
    },
    "DiagnosticSearchRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/DiagnosticScope"
        },
        "organization_id": {
          "$ref": "#/$defs/Identifier"
        },
        "signal": {
          "$ref": "#/$defs/DiagnosticSignal"
        },
        "start": {
          "$ref": "#/$defs/Timestamp"
        },
        "end": {
          "$ref": "#/$defs/Timestamp"
        },
        "filters": {
          "$ref": "#/$defs/DiagnosticFilters"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "scope",
        "signal",
        "start",
        "end",
        "limit"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "organization"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "organization_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "organization_id"
              ]
            }
          }
        }
      ],
      "description": "The window is at most the one-week diagnostic retention; the server derives the caller's identity and rights from the signed request, never from this body."
    },
    "DiagnosticRecord": {
      "type": "object",
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/Timestamp"
        },
        "signal": {
          "$ref": "#/$defs/DiagnosticSignal"
        },
        "service_name": {
          "$ref": "#/$defs/Identifier"
        },
        "event_name": {
          "$ref": "#/$defs/Identifier"
        },
        "module": {
          "$ref": "#/$defs/Identifier"
        },
        "outcome": {
          "$ref": "#/$defs/Identifier"
        },
        "error_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "severity": {
          "$ref": "#/$defs/Identifier"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "tenant_id": {
          "$ref": "#/$defs/Identifier"
        },
        "trace_id": {
          "$ref": "#/$defs/Identifier"
        },
        "span_id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "timestamp",
        "signal",
        "service_name"
      ],
      "additionalProperties": false,
      "description": "A projection of one stored record onto fixed, redacted fields; raw stored rows are never returned."
    },
    "DiagnosticSearchPage": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiagnosticRecord"
          },
          "maxItems": 200
        },
        "truncated": {
          "type": "boolean"
        },
        "took_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "required": [
        "records",
        "truncated",
        "took_ms"
      ],
      "additionalProperties": false
    },
    "GlobalDiagnosticChallenge": {
      "type": "object",
      "properties": {
        "challenge": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "namespace": {
          "const": "nds-global-admin@nddev.ai"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "challenge",
        "namespace",
        "expires_at"
      ],
      "additionalProperties": false,
      "description": "A one-time server challenge for the global diagnostic administrator key, bound to the requesting session and device."
    },
    "GlobalDiagnosticProof": {
      "type": "object",
      "properties": {
        "challenge": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "signature": {
          "type": "string",
          "minLength": 64,
          "maxLength": 2048,
          "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+\\n-----END SSH SIGNATURE-----\\n?$"
        }
      },
      "required": [
        "challenge",
        "signature"
      ],
      "additionalProperties": false,
      "description": "An SSHSIG (OpenSSH PROTOCOL.sshsig) signature in namespace nds-global-admin@nddev.ai over the exact challenge bytes."
    },
    "GlobalDiagnosticGrant": {
      "type": "object",
      "properties": {
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "key_fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
        }
      },
      "required": [
        "expires_at",
        "key_fingerprint"
      ],
      "additionalProperties": false,
      "description": "Global diagnostic access for the same session and device until expires_at; never a bearer token."
    }
  }
}
