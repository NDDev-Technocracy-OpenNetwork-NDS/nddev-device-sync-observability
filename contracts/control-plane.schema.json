{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nddev.ai/schemas/nddev-device-sync/v2/control-plane.schema.json",
  "title": "NDS control plane v2 definitions",
  "$comment": "Versioned identity, enrollment, sync and telemetry contracts. Adoption and runtime acceptance are owned by consuming module pins; schema presence does not claim an implemented endpoint.",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "LongIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "OpaqueToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])",
      "x-sensitive": true
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "AuthMethod": {
      "type": "string",
      "enum": [
        "email_otp",
        "github",
        "passkey"
      ]
    },
    "AuthMethods": {
      "type": "object",
      "properties": {
        "email_otp": {
          "$ref": "#/$defs/MethodAvailability"
        },
        "github": {
          "$ref": "#/$defs/MethodAvailability"
        },
        "passkey": {
          "$ref": "#/$defs/MethodAvailability"
        }
      },
      "required": [
        "email_otp",
        "github",
        "passkey"
      ],
      "additionalProperties": false
    },
    "EmailChallengeRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "format": "email",
          "x-sensitive": true
        }
      },
      "required": [
        "email"
      ],
      "additionalProperties": false
    },
    "EmailChallenge": {
      "type": "object",
      "properties": {
        "challenge_id": {
          "$ref": "#/$defs/Identifier"
        },
        "expires_in_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "resend_after_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "required": [
        "challenge_id",
        "expires_in_seconds",
        "resend_after_seconds"
      ],
      "additionalProperties": false
    },
    "EmailVerifyRequest": {
      "type": "object",
      "properties": {
        "challenge_id": {
          "$ref": "#/$defs/Identifier"
        },
        "code": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8,
          "pattern": "^[0-9]{8}(?![\\s\\S])",
          "x-sensitive": true
        }
      },
      "required": [
        "challenge_id",
        "code"
      ],
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "tenant_id": {
          "$ref": "#/$defs/Identifier"
        },
        "auth_method": {
          "$ref": "#/$defs/AuthMethod"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "user_id",
        "tenant_id",
        "auth_method",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "SessionIssued": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/$defs/Session"
        },
        "session_token": {
          "$ref": "#/$defs/OpaqueToken"
        }
      },
      "required": [
        "session",
        "session_token"
      ],
      "additionalProperties": false
    },
    "GithubStart": {
      "type": "object",
      "properties": {
        "flow_id": {
          "$ref": "#/$defs/Identifier"
        },
        "authorization_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri"
        },
        "exchange_token": {
          "$ref": "#/$defs/OpaqueToken"
        },
        "expires_in_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "poll_after_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "verification_code": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8,
          "pattern": "^[0-9]{8}(?![\\s\\S])",
          "description": "Comparison code displayed by the initiating app and browser approval page; not a bearer credential or email OTP."
        }
      },
      "required": [
        "flow_id",
        "authorization_url",
        "exchange_token",
        "expires_in_seconds",
        "poll_after_seconds",
        "verification_code"
      ],
      "additionalProperties": false
    },
    "GithubExchangeRequest": {
      "type": "object",
      "properties": {
        "flow_id": {
          "$ref": "#/$defs/Identifier"
        },
        "exchange_token": {
          "$ref": "#/$defs/OpaqueToken"
        }
      },
      "required": [
        "flow_id",
        "exchange_token"
      ],
      "additionalProperties": false
    },
    "GithubPending": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "pending"
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "status",
        "retry_after_seconds"
      ],
      "additionalProperties": false
    },
    "Platform": {
      "type": "string",
      "enum": [
        "macos",
        "linux",
        "windows",
        "ios",
        "android",
        "web"
      ]
    },
    "PublicKey": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])",
      "description": "Canonical unpadded base64url encoding of exactly 32 Ed25519 public-key bytes; the adapter also validates decoding and canonical form."
    },
    "Signature": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw](?![\\s\\S])",
      "description": "Canonical unpadded base64url encoding of exactly 64 Ed25519 signature bytes; the adapter verifies encoding and signature."
    },
    "EnrollmentRequest": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "public_key": {
          "$ref": "#/$defs/PublicKey"
        }
      },
      "required": [
        "platform",
        "display_name",
        "public_key"
      ],
      "additionalProperties": false
    },
    "EnrollmentChallenge": {
      "type": "object",
      "properties": {
        "challenge_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "challenge": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "challenge_id",
        "device_id",
        "challenge",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "EnrollmentProof": {
      "type": "object",
      "properties": {
        "challenge_id": {
          "$ref": "#/$defs/Identifier"
        },
        "signature": {
          "$ref": "#/$defs/Signature"
        }
      },
      "required": [
        "challenge_id",
        "signature"
      ],
      "additionalProperties": false
    },
    "Device": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "public_key": {
          "$ref": "#/$defs/PublicKey"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "device_id",
        "platform",
        "display_name",
        "public_key",
        "status",
        "created_at"
      ],
      "additionalProperties": false
    },
    "DeviceList": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Device"
          },
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "devices",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "SyncOperation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "device_state",
            "module_state",
            "vault_record",
            "account_state",
            "clipboard_item"
          ]
        },
        "entity_id": {
          "$ref": "#/$defs/LongIdentifier"
        },
        "base_revision": {
          "$ref": "#/$defs/Revision"
        },
        "idempotency_key": {
          "$ref": "#/$defs/LongIdentifier"
        },
        "payload": {
          "$ref": "#/$defs/EncryptedPayload"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "device_id",
        "entity_type",
        "entity_id",
        "base_revision",
        "idempotency_key",
        "payload"
      ],
      "additionalProperties": false
    },
    "SyncApplied": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "applied"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "server_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "outcome",
        "operation_id",
        "server_seq",
        "revision"
      ],
      "additionalProperties": false
    },
    "SyncConflict": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "conflict"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "server_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "base_revision": {
          "$ref": "#/$defs/Revision"
        },
        "current_revision": {
          "$ref": "#/$defs/Revision"
        },
        "resolution_state": {
          "type": "string",
          "const": "unresolved"
        }
      },
      "required": [
        "outcome",
        "operation_id",
        "server_seq",
        "base_revision",
        "current_revision",
        "resolution_state"
      ],
      "additionalProperties": false
    },
    "SyncResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/SyncApplied"
        },
        {
          "$ref": "#/$defs/SyncConflict"
        }
      ]
    },
    "SyncEntry": {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/SyncOperation"
        },
        "result": {
          "$ref": "#/$defs/SyncResult"
        }
      },
      "required": [
        "operation",
        "result"
      ],
      "additionalProperties": false
    },
    "SyncPage": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SyncEntry"
          },
          "maxItems": 100
        },
        "next_after_seq": {
          "$ref": "#/$defs/Revision"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "next_after_seq",
        "has_more"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "enum": [
            "invalid_request",
            "authentication_failed",
            "recent_authentication_required",
            "authorization_denied",
            "method_unavailable",
            "challenge_expired",
            "rate_limited",
            "device_revoked",
            "invalid_signature",
            "replayed_nonce",
            "idempotency_conflict",
            "operation_conflict",
            "cursor_expired",
            "revision_exhausted",
            "dependency_unavailable",
            "server_busy",
            "sync_capacity_exhausted",
            "request_timeout",
            "vault_key_registration_required"
          ]
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "MethodAvailability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "MethodAvailability"
    },
    "GithubApprovalForm": {
      "type": "object",
      "properties": {
        "flow_id": {
          "$ref": "#/$defs/Identifier"
        },
        "csrf_token": {
          "$ref": "#/$defs/OpaqueToken"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "deny"
          ]
        }
      },
      "required": [
        "flow_id",
        "csrf_token",
        "decision"
      ],
      "additionalProperties": false
    },
    "EncryptedPayload": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "aes-256-gcm"
        },
        "key_id": {
          "$ref": "#/$defs/Identifier"
        },
        "nonce": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_-]{16}(?![\\s\\S])"
        },
        "ciphertext": {
          "type": "string",
          "minLength": 22,
          "maxLength": 21867,
          "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])",
          "x-sensitive": true
        }
      },
      "required": [
        "algorithm",
        "key_id",
        "nonce",
        "ciphertext"
      ],
      "additionalProperties": false,
      "$comment": "Canonical unpadded base64url. Decode nonce to12 bytes and ciphertext to16..16400 bytes. Native AES-256-GCM authenticates owner, entity type/ID and key ID; plaintext never enters the server or telemetry."
    },
    "VaultKey": {
      "type": "object",
      "description": "Privileged native HTTPS key delivery only. Never expose through Flutter, agent transcripts, metadata stores or telemetry. The server has decryption authority.",
      "properties": {
        "key_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "key_material": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{64}(?![\\s\\S])",
          "x-sensitive": true,
          "description": "Canonical unpadded base64url of UUID bytes followed by the 32-byte owner key."
        }
      },
      "required": [
        "key_id",
        "key_material"
      ],
      "additionalProperties": false
    },
    "VaultKeyRequest": {
      "type": "object",
      "properties": {
        "existing_key": {
          "oneOf": [
            {
              "$ref": "#/$defs/VaultKey"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "existing_key"
      ],
      "additionalProperties": false
    },
    "PasskeyStart": {
      "type": "object",
      "properties": {
        "flow_id": {
          "$ref": "#/$defs/Identifier"
        },
        "authorization_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri"
        },
        "exchange_token": {
          "$ref": "#/$defs/OpaqueToken"
        },
        "expires_in_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "poll_after_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "verification_code": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8,
          "pattern": "^[0-9]{8}(?![\\s\\S])",
          "description": "Comparison code displayed by the initiating app and browser approval page; not a bearer credential or email OTP."
        }
      },
      "required": [
        "flow_id",
        "authorization_url",
        "exchange_token",
        "expires_in_seconds",
        "poll_after_seconds",
        "verification_code"
      ],
      "additionalProperties": false,
      "description": "Bounded native/browser WebAuthn handoff. Exchange token remains native; the browser proves authenticator possession and user verification before delivery."
    },
    "PasskeyRequest": {
      "type": "object",
      "properties": {
        "registration": {
          "type": "boolean"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "format": "email",
          "x-sensitive": true,
          "description": "Login account selector, never authentication. Omit for registration, which uses the authenticated session. Omission at login is accepted only when exactly one active account exists."
        }
      },
      "required": [
        "registration"
      ],
      "additionalProperties": false
    },
    "PasskeyStatus": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "registered"
          ]
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      },
      "required": [
        "status",
        "retry_after_seconds"
      ],
      "additionalProperties": false
    },
    "PasskeyInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "created_at"
      ],
      "additionalProperties": false
    },
    "PasskeyList": {
      "type": "object",
      "properties": {
        "passkeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PasskeyInfo"
          },
          "maxItems": 16
        }
      },
      "required": [
        "passkeys"
      ],
      "additionalProperties": false
    },
    "PasskeyRevocation": {
      "type": "object",
      "properties": {
        "current_session_revoked": {
          "type": "boolean"
        },
        "passkey_available": {
          "type": "boolean"
        }
      },
      "required": [
        "current_session_revoked",
        "passkey_available"
      ],
      "additionalProperties": false
    },
    "BrowserSessionIssued": {
      "type": "object",
      "description": "Same-origin browser session result. The credential is delivered only through the Secure HttpOnly host-only session cookie.",
      "properties": {
        "session": {
          "$ref": "#/$defs/Session"
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false
    },
    "BrowserCapabilities": {
      "type": "object",
      "properties": {
        "session_mode": {
          "type": "string",
          "enum": [
            "cookie"
          ]
        },
        "device_platform": {
          "type": "string",
          "enum": [
            "web"
          ]
        },
        "replica_protocol": {
          "type": "integer",
          "const": 2
        }
      },
      "required": [
        "session_mode",
        "device_platform",
        "replica_protocol"
      ],
      "additionalProperties": false
    },
    "InvitationEmailChallengeRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "format": "email",
          "x-sensitive": true
        },
        "invitation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "invitation_token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "x-sensitive": true
        }
      },
      "required": [
        "email",
        "invitation_id",
        "invitation_token"
      ],
      "additionalProperties": false,
      "description": "Begin normal email verification for the intended recipient of a live invitation. Invitation possession alone never activates membership or creates a session."
    },
    "SessionRenewal": {
      "type": "object",
      "description": "One successful device-bound server verification. Retains the original authentication proof; this metadata contains no credential and cannot itself renew authorization.",
      "properties": {
        "session": {
          "$ref": "#/$defs/Session"
        },
        "verified_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "authorization_id": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])",
          "x-sensitive": true,
          "description": "Canonical unpadded base64url identity for this retained server session, not an authentication token. Rust credential ownership only; never expose in presentation metadata or telemetry."
        }
      },
      "required": [
        "session",
        "verified_at",
        "authorization_id"
      ],
      "additionalProperties": false
    }
  }
}
